# File Upload
MAX_UPLOAD_SIZE_GIB=1
# Curl uploads (/u/) are encrypted in one shot, so the whole body plus its
# ciphertext plus the base64 of that sit in memory at once — peak RSS is ~2.7x
# this. Keep it well under the host's RAM; it is intentionally far below
# MAX_UPLOAD_SIZE_GIB. Mirror any change in docker/nginx/default.conf.
MAX_CURL_UPLOAD_MIB=64

# Session
SESSION_TIMEOUT_SECONDS=3600
CONNECTION_ID_LENGTH=6

# Per-session storage caps
MAX_BLOCKS_PER_SESSION=200
MAX_SESSION_BYTES_GIB=5

# Raw links serve *decrypted* content on a public URL. This is a real TTL from
# creation; links are also revoked when their block is edited or deleted.
RAW_LINK_TTL_SECONDS=600
MAX_RAW_LINKS_PER_SESSION=50

# Allowed Origins (comma-separated). Leave unset for "*", which also disables
# credentialed CORS. Only meaningful when the frontend is served from a
# different origin than the API.
ALLOWED_ORIGINS=http://localhost:8123

# Set to 1 to expose /api/v2/docs and the OpenAPI schema. Off by default.
ENABLE_DOCS=
